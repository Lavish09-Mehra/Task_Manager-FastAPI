# Environment variables
# Secrets - keep them in .env, never in git!

# --- App ---
APP_NAME=Task Manager API

# --- Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# dialect+driver://user:password@host:port/database
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/taskdb

# --- Debug (prints every SQL statement when True) ---
DEBUG=True